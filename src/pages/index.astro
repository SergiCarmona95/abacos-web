<script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script is:inline>
  var hash = window.location.hash
  var isIdentityAction = hash.indexOf('invite_token') !== -1 || hash.indexOf('confirmation_token') !== -1 || hash.indexOf('recovery_token') !== -1

  if (!isIdentityAction) {
    window.location.replace('/ca/')
  }
</script>
