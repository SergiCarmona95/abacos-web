---
import Layout from '../../layouts/Layout.astro'
import { getCollection } from 'astro:content'

const videos = await getCollection('videos')
const videosVisibles = videos.filter(v => v.data.mostrar)

function getYouTubeId(url: string) {
  const m = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&\s]+)/)
  return m ? m[1] : null
}

function getInstagramId(url: string) {
  const m = url.match(/instagram\.com\/(?:p|reel)\/([^\/\?]+)/)
  return m ? m[1] : null
}

function getThumbnail(url: string) {
  const ytId = getYouTubeId(url)
  if (ytId) return `https://img.youtube.com/vi/${ytId}/hqdefault.jpg`
  if (url.includes('cloudinary.com') && url.includes('/video/upload/')) {
    return url.replace('/video/upload/', '/video/upload/so_0,w_600/').replace(/\.(mp4|webm|ogg)(\?.*)?$/, '.jpg')
  }
  return null
}
---

<Layout title="Vídeos" lang="es" altLangUrl="/ca/videos" description="Vídeos de ÁBACOS, sindicato de trabajadores del Ayuntamiento de Barcelona.">

  <section class="max-w-xl mx-auto px-4 py-10">
    <p class="text-xs tracking-widest text-[#e63946] uppercase mb-2">Multimedia</p>
    <h1 class="text-2xl font-medium text-[#1a2e4a] mb-6">Vídeos</h1>

    {videosVisibles.length === 0 ? (
      <p class="text-sm text-gray-400">Pronto habrá vídeos publicados.</p>
    ) : (
      <div class="grid grid-cols-3 gap-2">
        {videosVisibles.map((v) => {
          const thumb = getThumbnail(v.data.url)
          const isInstagram = !!getInstagramId(v.data.url)
          return (
            <button
              class="video-card text-left group cursor-pointer"
              data-url={v.data.url}
              data-title={v.data.titolEs}
              data-desc={v.data.descripcioEs ?? ''}
            >
              <div class="aspect-square relative overflow-hidden rounded-lg bg-[#1a2e4a]">
                {thumb
                  ? <img src={thumb} alt={v.data.titolEs} class="w-full h-full object-cover" />
                  : isInstagram
                    ? <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-[#405de6] via-[#e1306c] to-[#f77737]">
                        <i class="ti ti-brand-instagram text-white text-3xl"></i>
                      </div>
                    : <div class="w-full h-full flex items-center justify-center bg-[#1a2e4a]">
                        <i class="ti ti-video text-white/40 text-3xl"></i>
                      </div>
                }
                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/40 transition-colors flex items-center justify-center">
                  <div class="opacity-0 group-hover:opacity-100 transition-opacity w-10 h-10 rounded-full bg-white/90 flex items-center justify-center">
                    <i class="ti ti-player-play-filled text-[#1a2e4a] text-base"></i>
                  </div>
                </div>
              </div>
              <p class="text-xs font-medium text-[#1a2e4a] mt-1.5 line-clamp-1">{v.data.titolEs}</p>
              {v.data.descripcioEs && (
                <p class="text-xs text-gray-400 line-clamp-2 mt-0.5">{v.data.descripcioEs}</p>
              )}
            </button>
          )
        })}
      </div>
    )}
  </section>

  <!-- Modal -->
  <div id="video-modal" class="fixed inset-0 z-50 bg-black/90 items-center justify-center p-4" style="display:none;">
    <div class="relative w-full max-w-2xl">
      <button id="modal-close" class="absolute -top-10 right-0 text-white/70 hover:text-white text-sm flex items-center gap-1.5">
        <i class="ti ti-x"></i> Cerrar
      </button>
      <div id="modal-content" class="rounded-xl overflow-hidden max-h-[75vh] overflow-y-auto"></div>
      <div class="mt-3">
        <p id="modal-title" class="text-white text-sm font-medium"></p>
        <p id="modal-desc" class="text-white/60 text-xs mt-1 leading-relaxed"></p>
      </div>
    </div>
  </div>

</Layout>

<script>
  const modal = document.getElementById('video-modal')
  const modalContent = document.getElementById('modal-content')
  const modalTitle = document.getElementById('modal-title')
  const modalDesc = document.getElementById('modal-desc')
  const closeBtn = document.getElementById('modal-close')

  function buildEmbed(url: string): string {
    const ytMatch = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&\s]+)/)
    if (ytMatch) {
      return `<div class="aspect-video"><iframe src="https://www.youtube.com/embed/${ytMatch[1]}?autoplay=1&enablejsapi=1" class="w-full h-full" allowfullscreen></iframe></div>`
    }
    const igMatch = url.match(/instagram\.com\/(?:p|reel)\/([^\/\?]+)/)
    if (igMatch) {
      return `<div style="background:linear-gradient(135deg,#405de6,#e1306c,#f77737);border-radius:0.75rem;padding:2.5rem;display:flex;flex-direction:column;align-items:center;gap:1rem;">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        <p style="color:white;font-size:0.875rem;font-weight:500;text-align:center;">Ver en Instagram</p>
        <a href="${url}" target="_blank" rel="noopener noreferrer" style="background:white;color:#e1306c;font-size:0.8rem;font-weight:600;padding:0.6rem 1.5rem;border-radius:9999px;text-decoration:none;">Abrir post →</a>
      </div>`
    }
    return `<video src="${url}" controls autoplay class="w-full rounded-xl max-h-[70vh]"></video>`
  }

  function openModal(url: string, title: string, desc: string) {
    if (!modal || !modalContent || !modalTitle || !modalDesc) return
    modalContent.innerHTML = buildEmbed(url)
    modalTitle.textContent = title
    modalDesc.textContent = desc
    ;(modal as HTMLElement).style.display = 'flex'
    document.body.style.overflow = 'hidden'
  }

  function closeModal() {
    if (!modal || !modalContent) return
    modalContent.innerHTML = ''
    ;(modal as HTMLElement).style.display = 'none'
    document.body.style.overflow = ''
  }

  document.querySelectorAll('.video-card').forEach(card => {
    card.addEventListener('click', () => {
      const el = card as HTMLElement
      openModal(el.dataset.url ?? '', el.dataset.title ?? '', el.dataset.desc ?? '')
    })
  })

  closeBtn?.addEventListener('click', closeModal)
  modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal() })
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal() })
</script>
