---
import Layout from '../../layouts/Layout.astro'
import { getCollection } from 'astro:content'

const documents = await getCollection('documents')

const categories = ['Convenios', 'Permisos y licencias', 'Afiliación', 'Otros']
---

<Layout title="Documentos" lang="es" altLangUrl="/ca/documents" description="Documentos, convenios y formularios para trabajadores públicos del Ayuntamiento de Barcelona.">

  <section class="max-w-5xl mx-auto px-6 py-16">
    <p class="text-xs tracking-widest text-[#e63946] uppercase mb-3">Recursos</p>
    <h1 class="text-3xl font-medium text-[#1a2e4a] mb-4">Documentos y descargas</h1>
    <p class="text-sm text-gray-500 leading-relaxed max-w-2xl mb-12">
      Accede a los convenios, permisos, licencias y formularios oficiales para los trabajadores públicos del Ayuntamiento de Barcelona y las administraciones de Cataluña.
    </p>

    {documents.length === 0 ? (
      <p class="text-sm text-gray-400">Todavía no hay documentos publicados.</p>
    ) : (
      <div class="flex flex-col gap-12">
        {categories.map((cat) => {
          const docs = documents.filter((d: any) => d.data.categoriaEs === cat)
          if (docs.length === 0) return null
          return (
            <div>
              <h2 class="text-sm font-medium text-[#1a2e4a] mb-4 pb-2 border-b border-gray-100">{cat}</h2>
              <div class="flex flex-col gap-3">
                {docs.map((doc: any) => (
                  <a href={doc.data.url} target="_blank" class="flex items-center gap-4 p-5 border border-gray-100 rounded-xl bg-gray-50 hover:border-gray-300 hover:bg-white transition-all group">
                    <div class="w-10 h-10 rounded-lg bg-[#e63946] flex items-center justify-center shrink-0">
                      <i class="ti ti-file-type-pdf text-white text-lg"></i>
                    </div>
                    <div class="flex-1">
                      <p class="text-sm font-medium text-[#1a2e4a] mb-0.5">{doc.data.nomEs}</p>
                    </div>
                    <div class="text-right shrink-0">
                      <p class="text-xs text-gray-400 mb-1">PDF · {doc.data.mida}</p>
                      <p class="text-xs text-[#e63946] group-hover:underline">Descargar →</p>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )
        })}
      </div>
    )}

  </section>

</Layout>