---
import Layout from '../../layouts/Layout.astro'

const documentos = [
  {
    categoria: 'Convenios',
    items: [
      { nom: 'Acuerdo de condiciones de trabajo 2021-2024', descripcio: 'Acuerdo de condiciones laborales del personal del Ayuntamiento de Barcelona.', mida: '2.4 MB', url: '/documents/acord-condicions-2021-2024.pdf' },
      { nom: 'Reglamento de la Junta de Personal', descripcio: 'Reglamento de funcionamiento interno de la Junta de Personal.', mida: '1.1 MB', url: '/documents/reglament-junta-personal.pdf' },
    ]
  },
  {
    categoria: 'Permisos y licencias',
    items: [
      { nom: 'Guía de permisos y licencias 2025', descripcio: 'Resumen actualizado de todos los permisos y licencias para empleados públicos.', mida: '890 KB', url: '/documents/permisos-llicencies-2025.pdf' },
      { nom: 'Derecho a la desconexión digital', descripcio: 'Guía práctica sobre el derecho a la desconexión digital fuera del horario laboral.', mida: '340 KB', url: '/documents/desconnexio-digital.pdf' },
    ]
  },
  {
    categoria: 'Afiliación',
    items: [
      { nom: 'Formulario de afiliación', descripcio: 'Formulario oficial para afiliarse a ÁBACOS.', mida: '180 KB', url: '/documents/formulari-afiliacio.pdf' },
    ]
  },
]
---

<Layout title="Documentos" lang="es" altLangUrl="/ca/documents" description="Documentos, convenios y formularios para trabajadores públicos del Ayuntamiento de Barcelona.">

  <section class="max-w-5xl mx-auto px-6 py-16">
    <p class="text-xs tracking-widest text-[#e63946] uppercase mb-3">Recursos</p>
    <h1 class="text-3xl font-medium text-[#1a2e4a] mb-4">Documentos y descargas</h1>
    <p class="text-sm text-gray-500 leading-relaxed max-w-2xl mb-12">
      Accede a los convenios, permisos, licencias y formularios oficiales para los trabajadores públicos del Ayuntamiento de Barcelona y las administraciones de Cataluña.
    </p>

    <div class="flex flex-col gap-12">
      {documentos.map((grup) => (
        <div>
          <h2 class="text-sm font-medium text-[#1a2e4a] mb-4 pb-2 border-b border-gray-100">{grup.categoria}</h2>
          <div class="flex flex-col gap-3">
            {grup.items.map((doc) => (
              <a href={doc.url} target="_blank" class="flex items-center gap-4 p-5 border border-gray-100 rounded-xl bg-gray-50 hover:border-gray-300 hover:bg-white transition-all group">
                <div class="w-10 h-10 rounded-lg bg-[#e63946] flex items-center justify-center shrink-0">
                  <i class="ti ti-file-type-pdf text-white text-lg"></i>
                </div>
                <div class="flex-1">
                  <p class="text-sm font-medium text-[#1a2e4a] mb-0.5">{doc.nom}</p>
                  <p class="text-xs text-gray-400">{doc.descripcio}</p>
                </div>
                <div class="text-right shrink-0">
                  <p class="text-xs text-gray-400 mb-1">PDF · {doc.mida}</p>
                  <p class="text-xs text-[#e63946] group-hover:underline">Descargar →</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

  </section>

</Layout>