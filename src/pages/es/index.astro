---
import Layout from '../../layouts/Layout.astro'
import { getCollection } from 'astro:content'
import VideoCarousel from '../../components/VideoCarousel.astro'

const noticies = await getCollection('noticies')
noticies.sort((a, b) => new Date(b.data.data).getTime() - new Date(a.data.data).getTime())
const ultimas = noticies.slice(0, 5)

const videos = await getCollection('videos')
const videosVisibles = videos.filter(v => v.data.mostrar).slice(0, 3)

const documents = await getCollection('documents')
const primersDocs = documents.slice(0, 3)
---

<Layout title="Inicio" lang="es" description="ÁBACOS, sindicato de trabajadores del Ayuntamiento de Barcelona y Administraciones de Cataluña. Defendemos tus derechos laborales.">

  <!-- Hero -->
  <section class="max-w-5xl mx-auto px-6 py-12 md:py-16 grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center">
    <div>
      <p class="text-xs tracking-widest text-[#e63946] uppercase mb-4">Sindicato · Ayuntamiento de Barcelona</p>
      <h1 class="text-2xl md:text-3xl font-medium text-[#1a2e4a] leading-snug mb-4">
        El sindicato de los trabajadores públicos de Barcelona
      </h1>
      <p class="text-sm text-gray-500 leading-relaxed mb-6">
        Defendemos tus derechos laborales con transparencia y compromiso. Delegados electos de la Junta de Personal del Ayuntamiento de Barcelona con más de 33 años de experiencia.
      </p>
      <div class="flex gap-3">
        <a href="/es/afiliacion" class="bg-[#1a2e4a] text-white text-sm px-5 py-2.5 rounded hover:bg-[#243d5e]">Afíliate ahora</a>
        <a href="/es/quienes-somos" class="border border-gray-300 text-[#1a2e4a] text-sm px-5 py-2.5 rounded hover:bg-gray-50">Quiénes somos</a>
      </div>
    </div>
    <div class="hidden md:flex bg-gray-100 rounded-xl h-56 items-center justify-center border border-gray-200">
      <p class="text-sm text-gray-400">Foto del equipo / Barcelona</p>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-y border-gray-100">
    <div class="max-w-5xl mx-auto px-6 grid grid-cols-3">
      <div class="py-6 md:py-8 pr-4 md:pr-8 border-r border-gray-100">
        <p class="text-2xl md:text-3xl font-medium text-[#1a2e4a]">33+</p>
        <p class="text-xs text-gray-400 mt-1">Años de experiencia</p>
      </div>
      <div class="py-6 md:py-8 px-4 md:px-8 border-r border-gray-100">
        <p class="text-2xl md:text-3xl font-medium text-[#1a2e4a]">4</p>
        <p class="text-xs text-gray-400 mt-1">Delegados electos activos</p>
      </div>
      <div class="py-6 md:py-8 pl-4 md:pl-8">
        <p class="text-2xl md:text-3xl font-medium text-[#1a2e4a]">100%</p>
        <p class="text-xs text-gray-400 mt-1">Independientes y sin ánimo de lucro</p>
      </div>
    </div>
  </section>

  <!-- Por qué afiliarte -->
  <section class="bg-gray-50 border-b border-gray-100">
    <div class="max-w-5xl mx-auto px-6 py-12">
      <h2 class="text-sm font-medium text-[#1a2e4a] mb-6">¿Por qué afiliarte a ÁBACOS?</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white border border-gray-100 rounded-lg p-4">
          <i class="ti ti-shield-check text-[#e63946] text-xl mb-2 block"></i>
          <h3 class="text-sm font-medium text-[#1a2e4a] mb-1">Representación legal</h3>
          <p class="text-xs text-gray-400 leading-relaxed">Te defendemos en cualquier ámbito administrativo o judicial.</p>
        </div>
        <div class="bg-white border border-gray-100 rounded-lg p-4">
          <i class="ti ti-users text-[#e63946] text-xl mb-2 block"></i>
          <h3 class="text-sm font-medium text-[#1a2e4a] mb-1">Negociación colectiva</h3>
          <p class="text-xs text-gray-400 leading-relaxed">Participamos en la negociación de convenios y condiciones laborales.</p>
        </div>
        <div class="bg-white border border-gray-100 rounded-lg p-4">
          <i class="ti ti-file-text text-[#e63946] text-xl mb-2 block"></i>
          <h3 class="text-sm font-medium text-[#1a2e4a] mb-1">Asesoramiento</h3>
          <p class="text-xs text-gray-400 leading-relaxed">Acceso a documentos, permisos e información laboral actualizada.</p>
        </div>
        <div class="bg-white border border-gray-100 rounded-lg p-4">
          <i class="ti ti-heart-handshake text-[#e63946] text-xl mb-2 block"></i>
          <h3 class="text-sm font-medium text-[#1a2e4a] mb-1">Solidaridad</h3>
          <p class="text-xs text-gray-400 leading-relaxed">Acción colectiva sin distinción de sexo, origen o ideología.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Noticias -->
  <section class="max-w-5xl mx-auto px-6 py-12 border-b border-gray-100">
    <h2 class="text-sm font-medium text-[#1a2e4a] mb-6">Últimas noticias</h2>
    {ultimas.length === 0 ? (
      <p class="text-sm text-gray-400">Pronto habrá noticias publicadas.</p>
    ) : (
      <div class="flex flex-col divide-y divide-gray-100">
        {ultimas.map((n) => (
          <a href={`/es/noticias/${n.data.identificador}`} class="py-4 flex gap-8 items-baseline hover:bg-gray-50 -mx-2 px-2 rounded transition-colors group">
            <span class="text-xs text-gray-400 min-w-[80px] shrink-0">{n.data.data}</span>
            <div>
              <p class="text-sm font-medium text-[#1a2e4a] mb-1 group-hover:text-[#e63946] transition-colors">{n.data.titolEs}</p>
              <span class="text-xs bg-gray-100 text-gray-500 px-2 py-0.5 rounded-full">{n.data.tagEs}</span>
            </div>
          </a>
        ))}
      </div>
    )}
    <a href="/es/noticias" class="inline-block mt-6 text-xs text-[#e63946] hover:underline">Ver todas las noticias →</a>
  </section>

  <!-- Vídeos -->
  {videosVisibles.length > 0 && (
    <section class="max-w-5xl mx-auto px-6 py-12 border-b border-gray-100">
      <h2 class="text-sm font-medium text-[#1a2e4a] mb-6">Vídeos</h2>
      <div class="max-w-2xl">
        <VideoCarousel videos={videosVisibles} lang="es" />
      </div>
      <a href="/es/videos" class="inline-block mt-6 text-xs text-[#e63946] hover:underline">Ver todos los vídeos →</a>
    </section>
  )}

  <!-- Documentos -->
  <section class="max-w-5xl mx-auto px-6 py-12">
    <h2 class="text-sm font-medium text-[#1a2e4a] mb-6">Documentos y descargas</h2>
    {primersDocs.length === 0 ? (
      <p class="text-sm text-gray-400">Pronto habrá documentos disponibles.</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {primersDocs.map((doc) => (
          <a href={doc.data.url} target="_blank" class="flex items-center gap-3 border border-gray-100 rounded-lg p-4 hover:border-gray-300 transition-colors">
            <i class="ti ti-file-type-pdf text-[#e63946] text-xl"></i>
            <div>
              <p class="text-sm font-medium text-[#1a2e4a]">{doc.data.nomEs}</p>
              <p class="text-xs text-gray-400">PDF · {doc.data.mida}</p>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>

</Layout>
