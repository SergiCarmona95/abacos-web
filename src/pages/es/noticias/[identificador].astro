---
import Layout from '../../../layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { marked } from 'marked'
import VideoEmbed from '../../../components/VideoEmbed.astro'

export async function getStaticPaths() {
  const noticies = await getCollection('noticies')
  return noticies.map(n => ({
    params: { identificador: n.data.identificador },
    props: { noticia: n },
  }))
}

const { noticia } = Astro.props

const rawBodyEs = noticia.data.bodyEs ? noticia.data.bodyEs.replace(/\\([#*\-_`])/g, '$1') : null
const rawBodyCa = (noticia.body ?? '').replace(/\\([#*\-_`])/g, '$1')
const bodyEsHtml = rawBodyEs ? await marked(rawBodyEs) : await marked(rawBodyCa)
---

<Layout title={noticia.data.titolEs} lang="es" altLangUrl={`/ca/noticies/${noticia.data.identificador}`} description={noticia.data.resumEs}>

  <article class="max-w-3xl mx-auto px-6 py-16">

    <div class="flex items-center gap-2 mb-6">
      <a href="/es/noticias" class="text-xs text-gray-400 hover:text-gray-600">← Noticias</a>
    </div>

    <div class="flex items-center gap-2 mb-4">
      <span class="text-xs text-[#e63946] font-medium">{noticia.data.tagEs}</span>
      <span class="text-gray-200">·</span>
      <span class="text-xs text-gray-400">{noticia.data.data}</span>
    </div>

    <h1 class="text-3xl font-medium text-[#1a2e4a] mb-6">{noticia.data.titolEs}</h1>

    {noticia.data.imatge && (
      <img src={noticia.data.imatge} alt={noticia.data.titolEs} class="w-full rounded-xl mb-8 object-cover max-h-80" />
    )}

    {noticia.data.videoUrl && noticia.data.mostrarVideo !== false && (
      <div class="mb-8">
        <VideoEmbed url={noticia.data.videoUrl} />
      </div>
    )}

    <div class="prose prose-sm max-w-none text-gray-600 leading-relaxed">
      <Fragment set:html={bodyEsHtml} />
    </div>

  </article>

</Layout>
