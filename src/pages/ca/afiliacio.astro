---
import Layout from '../../layouts/Layout.astro'
import { getCollection } from 'astro:content'

const docs = await getCollection('documents')
const formulari = docs.find(d => d.data.categoria === 'Afiliació')
---

<Layout title="Afilia't" altLangUrl="/es/afiliacion"  lang="ca" description="Afilia't a ÁBACOS, sindicat de treballadors de l'Ajuntament de Barcelona i administracions de Catalunya." >

  <section class="max-w-5xl mx-auto px-6 py-16">
    <p class="text-xs tracking-widest text-[#e63946] uppercase mb-3">Uneix-te</p>
    <h1 class="text-3xl font-medium text-[#1a2e4a] mb-4">Afilia't a ÁBACOS</h1>
    <p class="text-sm text-gray-500 leading-relaxed max-w-2xl mb-12">
      Formar part d'ÁBACOS significa tenir representació real, accés a assessorament jurídic i laboral, i la força col·lectiva de treballadors units per defensar els seus drets.
    </p>

    <!-- Beneficis -->
    <h2 class="text-sm font-medium text-[#1a2e4a] mb-6">Què inclou l'afiliació</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mb-16">
      <div class="border border-gray-100 rounded-xl p-6 bg-gray-50">
        <div class="w-10 h-10 rounded-lg bg-[#1a2e4a] flex items-center justify-center mb-4">
          <i class="ti ti-shield-check text-white text-lg"></i>
        </div>
        <h3 class="text-sm font-medium text-[#1a2e4a] mb-2">Representació legal</h3>
        <p class="text-xs text-gray-500 leading-relaxed">Defensa en qualsevol àmbit administratiu, corporatiu o judicial que afecti els teus drets com a empleat públic.</p>
      </div>
      <div class="border border-gray-100 rounded-xl p-6 bg-gray-50">
        <div class="w-10 h-10 rounded-lg bg-[#1a2e4a] flex items-center justify-center mb-4">
          <i class="ti ti-users text-white text-lg"></i>
        </div>
        <h3 class="text-sm font-medium text-[#1a2e4a] mb-2">Negociació col·lectiva</h3>
        <p class="text-xs text-gray-500 leading-relaxed">Participació en la negociació de convenis, condicions laborals i diàleg social amb les administracions.</p>
      </div>
      <div class="border border-gray-100 rounded-xl p-6 bg-gray-50">
        <div class="w-10 h-10 rounded-lg bg-[#1a2e4a] flex items-center justify-center mb-4">
          <i class="ti ti-file-text text-white text-lg"></i>
        </div>
        <h3 class="text-sm font-medium text-[#1a2e4a] mb-2">Assessorament</h3>
        <p class="text-xs text-gray-500 leading-relaxed">Accés a documents, guies, permisos i informació laboral actualitzada per a empleats públics.</p>
      </div>
      <div class="border border-gray-100 rounded-xl p-6 bg-gray-50">
        <div class="w-10 h-10 rounded-lg bg-[#1a2e4a] flex items-center justify-center mb-4">
          <i class="ti ti-school text-white text-lg"></i>
        </div>
        <h3 class="text-sm font-medium text-[#1a2e4a] mb-2">Formació sindical</h3>
        <p class="text-xs text-gray-500 leading-relaxed">Accés a cursos i activitats formatives sobre drets laborals, negociació i acció sindical.</p>
      </div>
      <div class="border border-gray-100 rounded-xl p-6 bg-gray-50">
        <div class="w-10 h-10 rounded-lg bg-[#1a2e4a] flex items-center justify-center mb-4">
          <i class="ti ti-heart-handshake text-white text-lg"></i>
        </div>
        <h3 class="text-sm font-medium text-[#1a2e4a] mb-2">Solidaritat</h3>
        <p class="text-xs text-gray-500 leading-relaxed">Acció col·lectiva sense distinció de sexe, origen, llengua, ideologia política o religiosa.</p>
      </div>
      <div class="border border-gray-100 rounded-xl p-6 bg-gray-50">
        <div class="w-10 h-10 rounded-lg bg-[#1a2e4a] flex items-center justify-center mb-4">
          <i class="ti ti-bell text-white text-lg"></i>
        </div>
        <h3 class="text-sm font-medium text-[#1a2e4a] mb-2">Informació prioritària</h3>
        <p class="text-xs text-gray-500 leading-relaxed">Rep notificacions i informació sobre canvis en convenis, permisos i condicions laborals abans que ningú.</p>
      </div>
    </div>

    <!-- Com afiliar-se -->
    <h2 class="text-sm font-medium text-[#1a2e4a] mb-6">Com afiliar-se</h2>
    <div class="flex flex-col gap-4 mb-12">
      <div class="flex gap-6 items-start p-6 border border-gray-100 rounded-xl bg-gray-50">
        <div class="w-8 h-8 rounded-full bg-[#e63946] flex items-center justify-center text-white text-sm font-medium shrink-0">1</div>
        <div>
          <h3 class="text-sm font-medium text-[#1a2e4a] mb-1">Descarrega el formulari</h3>
          <p class="text-xs text-gray-500 leading-relaxed mb-3">Descarrega el formulari oficial d'afiliació a ÁBACOS en format PDF.</p>
          {formulari && <a href={formulari.data.url} target="_blank" class="inline-flex items-center gap-2 text-xs text-[#e63946] border border-[#e63946] rounded-lg px-3 py-1.5 hover:bg-[#e63946] hover:text-white transition-all">
            <i class="ti ti-download"></i>
            Descarregar formulari
          </a>}
        </div>
      </div>

      <div class="flex gap-6 items-start p-6 border border-gray-100 rounded-xl bg-gray-50">
        <div class="w-8 h-8 rounded-full bg-[#e63946] flex items-center justify-center text-white text-sm font-medium shrink-0">2</div>
        <div>
          <h3 class="text-sm font-medium text-[#1a2e4a] mb-1">Omple les teves dades</h3>
          <p class="text-xs text-gray-500 leading-relaxed">Completa el formulari amb les teves dades personals i professionals. Tots els camps marcats amb * són obligatoris.</p>
        </div>
      </div>

      <div class="flex gap-6 items-start p-6 border border-gray-100 rounded-xl bg-gray-50">
        <div class="w-8 h-8 rounded-full bg-[#e63946] flex items-center justify-center text-white text-sm font-medium shrink-0">3</div>
        <div>
          <h3 class="text-sm font-medium text-[#1a2e4a] mb-1">Envia'l per correu o en persona</h3>
          <p class="text-xs text-gray-500 leading-relaxed">Envia el formulari completat a <span class="text-[#1a2e4a] font-medium">abacos@abacos.website</span> o porta'l personalment a les nostres oficines a Plaça Universitat 3, 6a planta, Barcelona.</p>
        </div>
      </div>

      <div class="flex gap-6 items-start p-6 border border-gray-100 rounded-xl bg-gray-50">
        <div class="w-8 h-8 rounded-full bg-[#e63946] flex items-center justify-center text-white text-sm font-medium shrink-0">4</div>
        <div>
          <h3 class="text-sm font-medium text-[#1a2e4a] mb-1">Benvingut a ÁBACOS</h3>
          <p class="text-xs text-gray-500 leading-relaxed">En rebre el teu formulari, et confirmarem l'afiliació per correu electrònic i tindràs accés a tots els serveis del sindicat.</p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="bg-[#1a2e4a] rounded-2xl p-8 flex items-center justify-between">
      <div>
        <h3 class="text-lg font-medium text-white mb-1">Tens alguna pregunta?</h3>
        <p class="text-sm text-blue-200">Contacta amb nosaltres i t'ajudarem en tot el procés.</p>
      </div>
      <a href="/ca/contacte" class="bg-[#e63946] text-white text-sm px-6 py-3 rounded-lg hover:bg-red-700 transition-colors shrink-0">
        Contacta'ns
      </a>
    </div>

  </section>

</Layout>