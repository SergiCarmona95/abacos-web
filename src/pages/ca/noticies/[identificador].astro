---
import Layout from '../../../layouts/Layout.astro'
import { getCollection, render } from 'astro:content'
import VideoEmbed from '../../../components/VideoEmbed.astro'

export async function getStaticPaths() {
  const noticies = await getCollection('noticies')
  return noticies.map(n => ({
    params: { identificador: n.data.identificador },
    props: { noticia: n },
  }))
}

const { noticia } = Astro.props
const { Content } = await render(noticia)
---

<Layout title={noticia.data.titol} lang="ca" altLangUrl={`/es/noticias/${noticia.data.identificador}`} description={noticia.data.resum}>

  <article class="max-w-3xl mx-auto px-6 py-16">

    <div class="flex items-center gap-2 mb-6">
      <a href="/ca/noticies" class="text-xs text-gray-400 hover:text-gray-600">← Notícies</a>
    </div>

    <div class="flex items-center gap-2 mb-4">
      <span class="text-xs text-[#e63946] font-medium">{noticia.data.tag}</span>
      <span class="text-gray-200">·</span>
      <span class="text-xs text-gray-400">{noticia.data.data}</span>
    </div>

    <h1 class="text-3xl font-medium text-[#1a2e4a] mb-6">{noticia.data.titol}</h1>

    {noticia.data.imatge && (
      <img src={noticia.data.imatge} alt={noticia.data.titol} class="w-full rounded-xl mb-8 object-cover max-h-80" />
    )}

    {noticia.data.videoUrl && noticia.data.mostrarVideo !== false && (
      <div class="mb-8">
        <VideoEmbed url={noticia.data.videoUrl} />
      </div>
    )}

    <div class="prose prose-sm max-w-none text-gray-600 leading-relaxed">
      <Content />
    </div>

  </article>

</Layout>
