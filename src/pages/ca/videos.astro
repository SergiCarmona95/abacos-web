---
import Layout from '../../layouts/Layout.astro'
import { getCollection } from 'astro:content'
import VideoEmbed from '../../components/VideoEmbed.astro'

const videos = await getCollection('videos')
const videosVisibles = videos.filter(v => v.data.mostrar)
---

<Layout title="Vídeos" lang="ca" altLangUrl="/es/videos" description="Vídeos d'ÁBACOS, sindicat de treballadors de l'Ajuntament de Barcelona.">

  <section class="max-w-5xl mx-auto px-6 py-16">

    <p class="text-xs tracking-widest text-[#e63946] uppercase mb-3">Multimèdia</p>
    <h1 class="text-3xl font-medium text-[#1a2e4a] mb-10">Vídeos</h1>

    {videosVisibles.length === 0 ? (
      <p class="text-sm text-gray-400">Aviat hi haurà vídeos publicats.</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        {videosVisibles.map((v) => (
          <div>
            <div class="rounded-xl overflow-hidden">
              <VideoEmbed url={v.data.url} />
            </div>
            <div class="mt-3">
              <p class="text-sm font-medium text-[#1a2e4a]">{v.data.titol}</p>
              {v.data.descripcio && <p class="text-xs text-gray-400 mt-1 leading-relaxed">{v.data.descripcio}</p>}
            </div>
          </div>
        ))}
      </div>
    )}

  </section>

</Layout>
