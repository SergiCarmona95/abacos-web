---
import Layout from '../../layouts/Layout.astro'
import { getCollection } from 'astro:content'
import VideoEmbed from '../../components/VideoEmbed.astro'

const videos = await getCollection('videos')
const videosVisibles = videos.filter(v => v.data.mostrar)
---

<Layout title="Vídeos" lang="ca" altLangUrl="/es/videos" description="Vídeos d'ÁBACOS, sindicat de treballadors de l'Ajuntament de Barcelona.">

  <section class="max-w-xl mx-auto px-4 py-10">

    <p class="text-xs tracking-widest text-[#e63946] uppercase mb-2">Multimèdia</p>
    <h1 class="text-2xl font-medium text-[#1a2e4a] mb-8">Vídeos</h1>

    {videosVisibles.length === 0 ? (
      <p class="text-sm text-gray-400">Aviat hi haurà vídeos publicats.</p>
    ) : (
      <div class="flex flex-col gap-0">
        {videosVisibles.map((v) => (
          <article class="border border-gray-200 rounded-2xl overflow-hidden mb-6">
            <div class="px-4 py-3 flex items-center gap-2.5 border-b border-gray-100">
              <div class="w-8 h-8 rounded-full bg-[#1a2e4a] flex items-center justify-center flex-shrink-0">
                <img src="/abacos-logo.png" alt="ÁBACOS" class="h-4" />
              </div>
              <div>
                <p class="text-xs font-semibold text-[#1a2e4a]">ÁBACOS</p>
                <p class="text-xs text-gray-400">Sindicat · Ajuntament de Barcelona</p>
              </div>
            </div>
            <VideoEmbed url={v.data.url} />
            <div class="px-4 py-3">
              <p class="text-sm font-medium text-gray-900">{v.data.titol}</p>
              {v.data.descripcio && (
                <p class="text-xs text-gray-500 mt-1 leading-relaxed">{v.data.descripcio}</p>
              )}
            </div>
          </article>
        ))}
      </div>
    )}

  </section>

</Layout>
