---
import Layout from '../../layouts/Layout.astro'
import { getCollection } from 'astro:content'
import VideoCarousel from '../../components/VideoCarousel.astro'

const noticies = await getCollection('noticies')
noticies.sort((a, b) => new Date(b.data.data).getTime() - new Date(a.data.data).getTime())
const darreres = noticies.slice(0, 5)

const videos = await getCollection('videos')
const videosVisibles = videos.filter(v => v.data.mostrar).slice(0, 3)

const documents = await getCollection('documents')
const primersDocs = documents.slice(0, 3)
---

<Layout title="Inici" lang="ca" description="ÁBACOS, sindicat de treballadors de l'Ajuntament de Barcelona i Administracions de Catalunya. Defensem els teus drets laborals.">

  <!-- Hero -->
  <section class="max-w-5xl mx-auto px-6 py-16 grid grid-cols-2 gap-12 items-center">
    <div>
      <p class="text-xs tracking-widest text-[#e63946] uppercase mb-4">Sindicat · Ajuntament de Barcelona</p>
      <h1 class="text-3xl font-medium text-[#1a2e4a] leading-snug mb-4">
        El sindicat dels treballadors públics de Barcelona
      </h1>
      <p class="text-sm text-gray-500 leading-relaxed mb-6">
        Defensem els teus drets laborals amb transparència i compromís. Delegats electes de la Junta de Personal de l'Ajuntament de Barcelona amb més de 33 anys d'experiència.
      </p>
      <div class="flex gap-3">
        <a href="/ca/afiliacio" class="bg-[#1a2e4a] text-white text-sm px-5 py-2.5 rounded hover:bg-[#243d5e]">Afilia't ara</a>
        <a href="/ca/qui-som" class="border border-gray-300 text-[#1a2e4a] text-sm px-5 py-2.5 rounded hover:bg-gray-50">Qui som</a>
      </div>
    </div>
    <div class="bg-gray-100 rounded-xl h-56 flex items-center justify-center border border-gray-200">
      <p class="text-sm text-gray-400">Foto de l'equip / Barcelona</p>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-y border-gray-100">
    <div class="max-w-5xl mx-auto px-6 grid grid-cols-3">
      <div class="py-8 pr-8 border-r border-gray-100">
        <p class="text-3xl font-medium text-[#1a2e4a]">33+</p>
        <p class="text-xs text-gray-400 mt-1">Anys d'experiència</p>
      </div>
      <div class="py-8 px-8 border-r border-gray-100">
        <p class="text-3xl font-medium text-[#1a2e4a]">4</p>
        <p class="text-xs text-gray-400 mt-1">Delegats electes actius</p>
      </div>
      <div class="py-8 pl-8">
        <p class="text-3xl font-medium text-[#1a2e4a]">100%</p>
        <p class="text-xs text-gray-400 mt-1">Independents i sense ànim de lucre</p>
      </div>
    </div>
  </section>

  <!-- Per què afiliar-te -->
  <section class="bg-gray-50 border-b border-gray-100">
    <div class="max-w-5xl mx-auto px-6 py-12">
      <h2 class="text-sm font-medium text-[#1a2e4a] mb-6">Per què afiliar-te a ÁBACOS?</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white border border-gray-100 rounded-lg p-4">
          <i class="ti ti-shield-check text-[#e63946] text-xl mb-2 block"></i>
          <h3 class="text-sm font-medium text-[#1a2e4a] mb-1">Representació legal</h3>
          <p class="text-xs text-gray-400 leading-relaxed">Et defensem en qualsevol àmbit administratiu o judicial.</p>
        </div>
        <div class="bg-white border border-gray-100 rounded-lg p-4">
          <i class="ti ti-users text-[#e63946] text-xl mb-2 block"></i>
          <h3 class="text-sm font-medium text-[#1a2e4a] mb-1">Negociació col·lectiva</h3>
          <p class="text-xs text-gray-400 leading-relaxed">Participem en la negociació de convenis i condicions laborals.</p>
        </div>
        <div class="bg-white border border-gray-100 rounded-lg p-4">
          <i class="ti ti-file-text text-[#e63946] text-xl mb-2 block"></i>
          <h3 class="text-sm font-medium text-[#1a2e4a] mb-1">Assessorament</h3>
          <p class="text-xs text-gray-400 leading-relaxed">Accés a documents, permisos i informació laboral actualitzada.</p>
        </div>
        <div class="bg-white border border-gray-100 rounded-lg p-4">
          <i class="ti ti-heart-handshake text-[#e63946] text-xl mb-2 block"></i>
          <h3 class="text-sm font-medium text-[#1a2e4a] mb-1">Solidaritat</h3>
          <p class="text-xs text-gray-400 leading-relaxed">Acció col·lectiva sense distinció de sexe, origen o ideologia.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Notícies -->
  <section class="max-w-5xl mx-auto px-6 py-12 border-b border-gray-100">
    <h2 class="text-sm font-medium text-[#1a2e4a] mb-6">Darreres notícies</h2>
    {darreres.length === 0 ? (
      <p class="text-sm text-gray-400">Aviat hi haurà notícies publicades.</p>
    ) : (
      <div class="flex flex-col divide-y divide-gray-100">
        {darreres.map((n) => (
          <a href={`/ca/noticies/${n.data.identificador}`} class="py-4 flex gap-8 items-baseline hover:bg-gray-50 -mx-2 px-2 rounded transition-colors group">
            <span class="text-xs text-gray-400 min-w-[80px] shrink-0">{n.data.data}</span>
            <div>
              <p class="text-sm font-medium text-[#1a2e4a] mb-1 group-hover:text-[#e63946] transition-colors">{n.data.titol}</p>
              <span class="text-xs bg-gray-100 text-gray-500 px-2 py-0.5 rounded-full">{n.data.tag}</span>
            </div>
          </a>
        ))}
      </div>
    )}
    <a href="/ca/noticies" class="inline-block mt-6 text-xs text-[#e63946] hover:underline">Veure totes les notícies →</a>
  </section>

  <!-- Vídeos -->
  {videosVisibles.length > 0 && (
    <section class="max-w-5xl mx-auto px-6 py-12 border-b border-gray-100">
      <h2 class="text-sm font-medium text-[#1a2e4a] mb-6">Vídeos</h2>
      <div class="max-w-2xl">
        <VideoCarousel videos={videosVisibles} lang="ca" />
      </div>
      <a href="/ca/videos" class="inline-block mt-6 text-xs text-[#e63946] hover:underline">Veure tots els vídeos →</a>
    </section>
  )}

  <!-- Documents -->
  <section class="max-w-5xl mx-auto px-6 py-12">
    <h2 class="text-sm font-medium text-[#1a2e4a] mb-6">Documents i descàrregues</h2>
    {primersDocs.length === 0 ? (
      <p class="text-sm text-gray-400">Aviat hi haurà documents disponibles.</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {primersDocs.map((doc) => (
          <a href={doc.data.url} target="_blank" class="flex items-center gap-3 border border-gray-100 rounded-lg p-4 hover:border-gray-300 transition-colors">
            <i class="ti ti-file-type-pdf text-[#e63946] text-xl"></i>
            <div>
              <p class="text-sm font-medium text-[#1a2e4a]">{doc.data.nom}</p>
              <p class="text-xs text-gray-400">PDF · {doc.data.mida}</p>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>

</Layout>
