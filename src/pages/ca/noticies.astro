---
import Layout from '../../layouts/Layout.astro'
import { getCollection } from 'astro:content'

const noticies = await getCollection('noticies')
noticies.sort((a, b) => new Date(b.data.data).getTime() - new Date(a.data.data).getTime())
---

<Layout title="Notícies" lang="ca" altLangUrl="/es/noticias" description="Notícies i actualitat del sindicat ÁBACOS de l'Ajuntament de Barcelona.">

  <section class="max-w-5xl mx-auto px-6 py-16">
    <p class="text-xs tracking-widest text-[#e63946] uppercase mb-3">Actualitat</p>
    <h1 class="text-3xl font-medium text-[#1a2e4a] mb-4">Notícies</h1>
    <p class="text-sm text-gray-500 leading-relaxed max-w-2xl mb-12">
      Informació i novetats del sindicat ÁBACOS i de l'àmbit laboral dels treballadors públics de Barcelona.
    </p>

    {noticies.length === 0 ? (
      <p class="text-sm text-gray-400">Encara no hi ha notícies publicades.</p>
    ) : (
      <div class="flex flex-col gap-6">
        {noticies.map((noticia) => (
          <article class="border border-gray-100 rounded-xl p-6 bg-gray-50 hover:border-gray-300 hover:bg-white transition-all">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs text-[#e63946] font-medium">{noticia.data.tag}</span>
              <span class="text-gray-200">·</span>
              <span class="text-xs text-gray-400">{noticia.data.data}</span>
            </div>
            <h2 class="text-base font-medium text-[#1a2e4a] mb-2">{noticia.data.titol}</h2>
            <p class="text-sm text-gray-500 leading-relaxed">{noticia.data.resum}</p>
          </article>
        ))}
      </div>
    )}

  </section>

</Layout>
