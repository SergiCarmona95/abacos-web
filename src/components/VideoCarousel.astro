---
import VideoEmbed from './VideoEmbed.astro'

interface Props {
  videos: any[]
  lang?: string
}

const { videos, lang = 'ca' } = Astro.props
---

<div class="vc-carousel flex items-center gap-3">

  {videos.length > 1 && (
    <button class="vc-prev flex-shrink-0 w-10 h-10 rounded-full border border-gray-200 text-gray-400 hover:border-[#1a2e4a] hover:text-[#1a2e4a] transition-colors flex items-center justify-center">
      <i class="ti ti-arrow-left text-sm"></i>
    </button>
  )}

  <div class="flex-1 min-w-0">
    {videos.map((v, i) => (
      <div class="vc-slide" data-index={i}>
        <VideoEmbed url={v.data.url} />
        <div class="mt-3">
          <p class="text-sm font-medium text-[#1a2e4a]">
            {lang === 'es' ? v.data.titolEs : v.data.titol}
          </p>
          {lang === 'es'
            ? v.data.descripcioEs && <p class="text-xs text-gray-400 mt-1">{v.data.descripcioEs}</p>
            : v.data.descripcio && <p class="text-xs text-gray-400 mt-1">{v.data.descripcio}</p>
          }
        </div>
      </div>
    ))}
    {videos.length > 1 && (
      <p class="vc-counter text-xs text-gray-400 text-center mt-3">1 / {videos.length}</p>
    )}
  </div>

  {videos.length > 1 && (
    <button class="vc-next flex-shrink-0 w-10 h-10 rounded-full border border-gray-200 text-gray-400 hover:border-[#1a2e4a] hover:text-[#1a2e4a] transition-colors flex items-center justify-center">
      <i class="ti ti-arrow-right text-sm"></i>
    </button>
  )}

</div>

<style>
  .vc-slide {
    display: none;
  }
  .vc-slide.vc-active {
    display: block;
  }
</style>

<script>
  document.querySelectorAll('.vc-carousel').forEach((carousel) => {
    const slides = [...carousel.querySelectorAll('.vc-slide')]
    const counter = carousel.querySelector('.vc-counter')
    const prevBtn = carousel.querySelector('.vc-prev')
    const nextBtn = carousel.querySelector('.vc-next')
    let current = 0

    if (slides.length === 0) return
    slides[0].classList.add('vc-active')

    function pauseSlide(slide: Element) {
      slide.querySelectorAll('iframe').forEach((el: Element) => {
        const iframe = el as HTMLIFrameElement
        if (iframe.src.includes('youtube.com/embed')) {
          try {
            iframe.contentWindow?.postMessage(
              JSON.stringify({ event: 'command', func: 'pauseVideo', args: [] }), '*'
            )
          } catch (e) {}
        } else {
          iframe.dataset.savedSrc = iframe.src
          iframe.src = ''
        }
      })
      slide.querySelectorAll('video').forEach((el: Element) => (el as HTMLVideoElement).pause())
    }

    function restoreSlide(slide: Element) {
      slide.querySelectorAll('iframe').forEach((el: Element) => {
        const iframe = el as HTMLIFrameElement
        if (!iframe.src && iframe.dataset.savedSrc) {
          iframe.src = iframe.dataset.savedSrc
        }
      })
    }

    function goTo(index: number) {
      pauseSlide(slides[current])
      slides[current].classList.remove('vc-active')
      current = ((index % slides.length) + slides.length) % slides.length
      slides[current].classList.add('vc-active')
      restoreSlide(slides[current])
      if (counter) counter.textContent = `${current + 1} / ${slides.length}`
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1))
    nextBtn?.addEventListener('click', () => goTo(current + 1))
  })
</script>
